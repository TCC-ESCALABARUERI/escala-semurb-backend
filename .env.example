NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Neon: copie a connection string "pooled" (termina com ?sslmode=require)
DATABASE_URL=postgresql://usuario:senha@host/escala_semurb?sslmode=require
# Local: 10 · Vercel: 1
DB_MAX_CONNECTIONS=10

JWT_SECRET=troque-por-uma-string-longa-e-aleatoria
JWT_EXPIRES_IN=12h

# Master (fora do banco). Gere o hash com: npm run hash -- "suaSenha"
MASTER_REGISTRATION=master
MASTER_PASSWORD_HASH=

# SMTP (opcional em dev: sem SMTP o código aparece no console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Escala SEMURB <no-reply@seudominio.com>"
