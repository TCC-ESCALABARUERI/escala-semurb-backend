{
  "name": "escala-semurb-backend",
  "version": "2.0.0",
  "description": "API de gestão de escalas de trabalho da SEMURB",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node src/server.js",
    "test": "node --test tests/**/*.test.js",
    "db:schema": "node scripts/apply-schema.js",
    "hash": "node scripts/hash-password.js",
    "format": "prettier --write .",
    "db:seed": "node scripts/seed.js"
  },
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.14",
    "pdfkit": "^0.20.2",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
